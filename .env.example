# Copy to .env (make env-setup). Set ENV_FILE to load a different file.
# Real environment variables always take precedence over this file.

# App
APP_NAME=go-boilerplate
APP_VERSION=0.1.0

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=debug                # debug, release, test (release enforces secrets)
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_MAX_BODY_BYTES=4194304 # 4 MB
TRUSTED_PROXIES=              # comma-separated LB/proxy IPs or CIDRs; empty = trust none
INTERNAL_API_KEY=             # required for /internal/* routes (X-API-Key header)

# TLS
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# Database
DB_ENABLED=true
DB_AUTO_MIGRATE=false         # run pending migrations on startup
DB_DRIVER=postgres            # postgres, mysql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable           # disable, require, verify-ca, verify-full
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m
DB_SLOW_THRESHOLD=200ms

# Cache (in-memory unless USE_REDIS=true)
USE_REDIS=false
CACHE_DEFAULT_TTL=60s
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (secret must be >= 32 chars outside debug mode)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=go-boilerplate

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com
FROM_NAME=App

# Logger
LOG_LEVEL=debug               # debug, info, warn, error
LOG_FORMAT=json               # json, text
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=100              # MB per file before rotation
LOG_MAX_FILES=7
LOG_ENABLE_CONSOLE=true

# Storage
STORAGE_DRIVER=local          # local, s3, gcs
STORAGE_LOCAL_PATH=./uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# Global per-IP rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=300
RATE_LIMIT_WINDOW=1m

# CORS ("*" allows any origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Authorization,X-Request-ID,X-API-Key
CORS_EXPOSED_HEADERS=X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400
